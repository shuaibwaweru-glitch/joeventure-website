{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/pages/index.html"
    },
    {
      "src": "/about",
      "dest": "/pages/about.html"
    },
    {
      "src": "/packages",
      "dest": "/pages/packages.html"
    },
    {
      "src": "/destinations",
      "dest": "/pages/destinations.html"
    },
    {
      "src": "/support",
      "dest": "/pages/support.html"
    },
    {
      "src": "/gallery",
      "dest": "/pages/gallery.html"
    },
    {
      "src": "/testimonials",
      "dest": "/pages/testimonials.html"
    },
    {
      "src": "/blog",
      "dest": "/pages/blog.html"
    },
    {
      "src": "/contact",
      "dest": "/pages/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
